{
  "name": "itelect4-backend",
  "version": "0.1.0",
  "description": "REST API for the Peer Tutoring platform -- Express + MongoDB + JWT in TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=verbose",
    "try-ai": "tsx src/try-ai.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "mongodb",
    "jwt",
    "gemini"
  ],
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.32.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.15.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.0.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  }
}
