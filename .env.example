# Copy this file to .env and fill in the real values.
# .env is gitignored -- NEVER commit it.
#
# Deployed, there is no .env file: MONGODB_URI, JWT_SECRET, JWT_EXPIRES_IN
# and CORS_ORIGIN are typed into Vercel -> Project -> Settings ->
# Environment Variables instead. PORT is local only; on Vercel app.listen
# never runs.

PORT=4000
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# The frontend's address, no trailing slash. Locally that is Vite on
# port 3000; on Vercel it is the frontend's https://<name>.vercel.app.
# Several origins can be listed with commas.
CORS_ORIGIN=http://localhost:3000

# Only read by npm run seed (local). The tutor who owns the seeded
# sessions. The password is only used the first time, when the tutor
# account is created -- changing it here later does not change the login.
SEED_TUTOR_EMAIL=
SEED_TUTOR_PASSWORD=

# Gemini (Session 11). Get a key at https://aistudio.google.com/apikey.
# Server only -- the browser never sees it. On Vercel, add it under
# Environment Variables like the others.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash.
GEMINI_MODEL=
